          kills: 0,
          deaths: 0,
          assists: 0,
          kp: 0,
          dpm: 0,
          cspm: 0
        });
      }

      const g = generalAgg.get(generalKey);
      g.games += 1;
      g.wins += toNumber_(r[11]);
      g.kills += toNumber_(r[13]);
      g.deaths += toNumber_(r[14]);
      g.assists += toNumber_(r[15]);
      g.kp += toNumber_(r[17]);
      g.dpm += toNumber_(r[23]);
      g.cspm += toNumber_(r[29]);

      if (realRole === primaryRole) {
        const roleKey = `${primaryRole}__${player}`;
        if (!roleAgg.has(roleKey)) {
          roleAgg.set(roleKey, {
            player,
            role: primaryRole,
            games: 0,
            wins: 0,
            kills: 0,
            deaths: 0,
            assists: 0,
            kp: 0,
            dpm: 0,
            cspm: 0
          });
        }

        const rr = roleAgg.get(roleKey);
        rr.games += 1;
        rr.wins += toNumber_(r[11]);
        rr.kills += toNumber_(r[13]);
        rr.deaths += toNumber_(r[14]);
        rr.assists += toNumber_(r[15]);
        rr.kp += toNumber_(r[17]);
        rr.dpm += toNumber_(r[23]);
        rr.cspm += toNumber_(r[29]);
      }
    });

    output.push([`SERIES ${seriesId}`, '', '', '', '', '', '', '', '', '', '', '', '', '', '']);
