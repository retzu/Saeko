function lookupRecentSeries() {
  try {
    const apiKey = getApiKey_();
    const importerSheet = mustGetSheet_(CONFIG.IMPORTER_SHEET);
    const tournamentId = String(importerSheet.getRange(CONFIG.TOURNAMENT_LOOKUP_CELL).getValue()).trim();

    if (!tournamentId) {
      throw buildError_(
        'VALIDATION_ERROR',
        'lookupRecentSeries',
        `Write a tournament id in ${CONFIG.IMPORTER_SHEET}!${CONFIG.TOURNAMENT_LOOKUP_CELL}`,
        {}
      );
    }

    const query = `
      {
        allSeries(
          filter: {
            tournament: {
              id: { in: [${JSON.stringify(tournamentId)}] }
              includeChildren: { equals: true }
            }
          }
          orderBy: StartTimeScheduled
        ) {
          totalCount
          edges {
            node {
              id
              startTimeScheduled
              teams {
                baseInfo {
                  name
                }
              }
            }
          }
        }
      }
    `;

    const data = postGraphQL_(CONFIG.CENTRAL_DATA_GRAPHQL, query, apiKey, 'lookupRecentSeries');
    const edges = data?.allSeries?.edges || [];

    if (!edges.length) {
      SpreadsheetApp.getUi().alert(`No series found for tournament ${tournamentId}.`);
      return;
    }

    const preview = edges.slice(0, 10).map(e => {
      const node = e.node || {};
      const teams = (node.teams || []).map(t => t?.baseInfo?.name || 'Unknown').join(' vs ');
      return `${node.id} | ${node.startTimeScheduled || 'N/A'} | ${teams}`;
    }).join('\n');

    SpreadsheetApp.getUi().alert(`Recent series:\n\n${preview}`);
  } catch (err) {
    handleError_(err);
  }
}

