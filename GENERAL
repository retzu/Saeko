    Array.from(generalAgg.values())
      .map(rec => {
        const avgDeaths = safeDivide_(rec.deaths, rec.games);
        const avgKills = safeDivide_(rec.kills, rec.games);
        const avgAssists = safeDivide_(rec.assists, rec.games);
        const avgKda = avgDeaths === 0 ? (avgKills + avgAssists) : ((avgKills + avgAssists) / avgDeaths);

        return [
          'GENERAL',
          rec.role,
          rec.role,
          roleChipMap[rec.player] || '',
          rec.player,
          rec.games,
          rec.wins,
          safeDivide_(rec.wins, rec.games),
          avgKills,
          avgDeaths,
          avgAssists,
          avgKda,
          safeDivide_(rec.kp, rec.games),
          safeDivide_(rec.dpm, rec.games),
          safeDivide_(rec.cspm, rec.games)
        ];
      })
      .sort((a, b) => String(a[1]).localeCompare(String(b[1])) || String(a[4]).localeCompare(String(b[4])))
      .forEach(row => output.push(row));

    Array.from(roleAgg.values())
      .map(rec => {
        const avgDeaths = safeDivide_(rec.deaths, rec.games);
        const avgKills = safeDivide_(rec.kills, rec.games);
        const avgAssists = safeDivide_(rec.assists, rec.games);
        const avgKda = avgDeaths === 0 ? (avgKills + avgAssists) : ((avgKills + avgAssists) / avgDeaths);

        return [
          'ROLE',
          rec.role,
          rec.role,
          roleChipMap[rec.player] || '',
          rec.player,
          rec.games,
          rec.wins,
          safeDivide_(rec.wins, rec.games),
          avgKills,
          avgDeaths,
          avgAssists,
          avgKda,
          safeDivide_(rec.kp, rec.games),
          safeDivide_(rec.dpm, rec.games),
          safeDivide_(rec.cspm, rec.games)
        ];
      })
      .sort((a, b) => String(a[1]).localeCompare(String(b[1])) || String(a[4]).localeCompare(String(b[4])))
      .forEach(row => output.push(row));

    output.push(['', '', '', '', '', '', '', '', '', '', '', '', '', '', '']);
  });

  if (output.length) {
    generalSheet.getRange(1, 1, output.length, output[0].length).setValues(output);
  }

  writeRoleMappingSheet_(data);
