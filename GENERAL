function saveRowsToDb_(rows) {
  const sheet = mustGetSheet_(CONFIG.DB_SHEET);
  ensureHeaders_(sheet, CONFIG.DB_HEADERS);

  const dedupedRows = removeDuplicateRowsAgainstSheet_(sheet, rows);
  if (!dedupedRows.length) return 0;

  for (let i = 0; i < dedupedRows.length; i += CONFIG.WRITE_CHUNK_SIZE) {
    const chunk = dedupedRows.slice(i, i + CONFIG.WRITE_CHUNK_SIZE);
    const startRow = sheet.getLastRow() + 1;
    sheet.getRange(startRow, 1, chunk.length, chunk[0].length).setValues(chunk);
  }

  return dedupedRows.length;
}

function removeDuplicateRowsAgainstSheet_(sheet, newRows) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return newRows;

  const existing = sheet.getRange(2, 1, lastRow - 1, CONFIG.DB_HEADERS.length).getValues();
  const existingKeys = new Set(existing.map(r => buildRowKey_(r)));

  return newRows.filter(row => !existingKeys.has(buildRowKey_(row)));
}

function buildRowKey_(row) {
  return [
    row[1],
    row[2],
    row[6],
    row[10]
  ].map(v => String(v || '').trim().toLowerCase()).join('__');
}

/* =========================
 * ROLE LOGIC
 * ========================= */

function buildRoleCountMapFromDb_(rows) {
  const counts = {};

  rows.forEach(r => {
    const player = String(r[6] || '').trim();
    const role = normalizeRole_(r[9]);

    if (!player || !role) return;
    if (!counts[player]) counts[player] = {};
    counts[player][role] = (counts[player][role] || 0) + 1;
  });

  return counts;
}

function buildPrimaryRoleMapFromDb_(rows) {
  const counts = buildRoleCountMapFromDb_(rows);
  const out = {};

  Object.keys(counts).forEach(player => {
    const sorted = Object.entries(counts[player]).sort((a, b) => b[1] - a[1]);
    out[player] = sorted.length ? sorted[0][0] : 'UNKNOWN';
  });

  return out;
}

function buildRoleChipMapFromDb_(rows) {
  const counts = buildRoleCountMapFromDb_(rows);
  const out = {};

  Object.keys(counts).forEach(player => {
    out[player] = Object.entries(counts[player])
      .sort((a, b) => b[1] - a[1])
      .map(([role, n]) => `${role} (${n})`)
      .join(' | ');
  });

  return out;
}

function writeRoleMappingSheet_(rows) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = getOrCreateSheet_(ss, CONFIG.ROLE_MAP_SHEET);
  sheet.clearContents();
  sheet.getRange(1, 1, 1, CONFIG.ROLE_MAP_HEADERS.length).setValues([CONFIG.ROLE_MAP_HEADERS]);

  const primaryRoleMap = buildPrimaryRoleMapFromDb_(rows);
  const roleChipMap = buildRoleChipMapFromDb_(rows);
  const roleCountMap = buildRoleCountMapFromDb_(rows);

  const output = Object.keys(primaryRoleMap)
    .sort()
    .map(player => [
      player,
      primaryRoleMap[player],
      roleChipMap[player] || '',
      JSON.stringify(roleCountMap[player] || {})
    ]);

  if (output.length) {
    sheet.getRange(2, 1, output.length, output[0].length).setValues(output);
  }
}

