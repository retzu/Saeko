/* =========================
 * SAFE ACCESS / HELPERS
 * ========================= */

function safeGet_(obj, path, options) {
  const opts = options || {};
  let current = obj;

  for (let i = 0; i < path.length; i++) {
    const key = path[i];

    if (current == null || !(key in current)) {
      if (opts.required) {
        throw buildError_(
          'SCHEMA_ERROR',
          opts.step || 'safeGet',
          `Missing JSON path: ${path.join('.')}`,
          Object.assign({}, opts.context || {}, {
            missingPath: path.join('.'),
            traversedUntil: path.slice(0, i).join('.'),
            availableKeys: current && typeof current === 'object' ? Object.keys(current) : []
          })
        );
      }
      return opts.defaultValue;
    }

    current = current[key];
  }

  return current;
}

function parseJson_(text, step, context) {
  try {
    return JSON.parse(text);
  } catch (e) {
    throw buildError_(
      'JSON_PARSE_ERROR',
      step,
      `Invalid JSON: ${e.message}`,
      Object.assign({}, context || {}, {
        preview: truncate_(text, CONFIG.MAX_ERROR_BODY_CHARS)
      })
    );
  }
}

function findTeamById_(teams, teamId) {
  return (teams || []).find(t => toNumber_(t.teamId) === toNumber_(teamId)) || {};
}

function splitTeamTagAndPlayerNickname_(summonerName) {
  let teamTag = '';
  let playerName = summonerName || '';

  if (summonerName && summonerName.indexOf(' ') !== -1 && summonerName.indexOf(' ') < 5) {
    const prefix = summonerName.split(' ')[0];
    if (prefix === prefix.toUpperCase()) {
      teamTag = prefix;
      playerName = summonerName.substring(summonerName.indexOf(' ') + 1);
    }
  }

  return { teamTag, playerName };
}

function normalizeRole_(rawRole) {
  const role = String(rawRole || '').trim().toUpperCase();
  return ROLE_ALIASES[role] || role || 'UNKNOWN';
}

function normalizeTournamentName_(name) {
  return name === 'League of Legends Scrims' ? 'Scrim' : String(name || '').trim();
}

function normalizeSideFromTeamId_(teamId) {
  const n = toNumber_(teamId);
  if (n === 100) return 'BLUE';
  if (n === 200) return 'RED';
  return 'UNKNOWN';
}

function safeDivide_(num, den) {
  const n = toNumber_(num);
  const d = toNumber_(den);
  return d === 0 ? 0 : n / d;
}

function safePerMinute_(value, durationSeconds) {
  const minutes = toNumber_(durationSeconds) / 60;
  return minutes === 0 ? 0 : toNumber_(value) / minutes;
}

function toNumber_(value) {
  if (value === null || value === undefined || value === '') return 0;
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
}

function intBool_(value) {
  return value ? 1 : 0;
}

function truncate_(text, maxLen) {
  const s = String(text || '');
  return s.length > maxLen ? s.slice(0, maxLen) + 'â€¦' : s;
}

/* =========================
 * ERROR HANDLING / LOGGING
 * ========================= */

function buildError_(code, step, message, context) {
  const err = new Error(message);
  err.name = 'AppError';
  err.code = code;
  err.step = step;
  err.context = context || {};
  return err;
}

function handleError_(err) {
  logStructuredError_(err);
  writeLogRow_(err);

  const message = `[${err.code || 'ERROR'}] ${err.step || 'unknown'}: ${err.message}`;
  SpreadsheetApp.getActiveSpreadsheet().toast(message, 'GRID Import', 8);
  SpreadsheetApp.getUi().alert(message);
}

function logStructuredError_(err) {
  const payload = {
    name: err.name || 'Error',
    code: err.code || 'UNKNOWN',
    step: err.step || 'unknown',
    message: err.message || 'Unknown error',
    context: err.context || {},
    stack: err.stack || null,
    timestamp: new Date().toISOString()
  };

  console.error(JSON.stringify(payload));
  Logger.log(JSON.stringify(payload));
}

function writeLogRow_(err) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = getOrCreateSheet_(ss, CONFIG.LOG_SHEET);
    ensureHeaders_(sheet, CONFIG.LOG_HEADERS);

    sheet.getRange(sheet.getLastRow() + 1, 1, 1, 6).setValues([[
      new Date(),
      'ERROR',
      err.code || 'UNKNOWN',
      err.step || 'unknown',
      err.message || 'Unknown error',
      JSON.stringify(err.context || {})
    ]]);
  } catch (logErr) {
    Logger.log(`Log write failed: ${logErr.message}`);
  }
}
