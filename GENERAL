function fetchSeriesInfo_(seriesId, apiKey) {
  const query = `
    {
      series(id: ${seriesId}) {
        id
        type
        tournament {
          id
          name
          nameShortened
        }
      }
    }
  `;

  const data = postGraphQL_(CONFIG.CENTRAL_DATA_GRAPHQL, query, apiKey, 'fetchSeriesInfo');
  const series = safeGet_(data, ['series'], {
    required: true,
    step: 'fetchSeriesInfo',
    context: { seriesId, rootKeys: Object.keys(data || {}) }
  });

  return {
    series_id: String(seriesId),
    tournament_id: safeGet_(series, ['tournament', 'id'], { defaultValue: '' }),
    tournament_name: normalizeTournamentName_(safeGet_(series, ['tournament', 'name'], { defaultValue: '' }))
  };
}

function fetchSeriesGames_(seriesId, apiKey) {
  const query = `
    {
      seriesState(id: ${seriesId}) {
        id
        games {
          id
          sequenceNumber
          started
          finished
        }
      }
    }
  `;

  const data = postGraphQL_(CONFIG.SERIES_STATE_GRAPHQL, query, apiKey, 'fetchSeriesGames');
  const games = safeGet_(data, ['seriesState', 'games'], {
    required: true,
    step: 'fetchSeriesGames',
    context: { seriesId }
  });

  if (!Array.isArray(games)) {
    throw buildError_(
      'SCHEMA_ERROR',
      'fetchSeriesGames',
      'seriesState.games is not an array',
      { seriesId, receivedType: typeof games }
    );
  }

  return games;
}

function fetchGameSummary_(seriesId, sequenceNumber, apiKey) {
  return getJson_(
    `file-download/end-state/riot/series/${seriesId}/games/${sequenceNumber}/summary`,
    apiKey,
    'fetchGameSummary',
    { seriesId, sequenceNumber }
  );
}

function fetchGameDetails_(seriesId, sequenceNumber, apiKey) {
  return getJson_(
    `file-download/end-state/riot/series/${seriesId}/games/${sequenceNumber}/details`,
    apiKey,
    'fetchGameDetails',
    { seriesId, sequenceNumber }
  );
}

function postGraphQL_(endpoint, query, apiKey, step) {
  const url = `${CONFIG.API_BASE_URL}/${endpoint}`;
  const payload = JSON.stringify({ query });

  for (let attempt = 1; attempt <= CONFIG.MAX_RETRIES; attempt++) {
    try {
      const response = UrlFetchApp.fetch(url, {
        method: 'post',
        contentType: 'application/json',
        headers: {
          'x-api-key': apiKey,
          'Accept': 'application/json'
        },
        payload,
        muteHttpExceptions: true
      });

      const status = response.getResponseCode();
      const body = response.getContentText();

      if (status === 200) {
        const json = parseJson_(body, step, { endpoint });

        if (json?.errors?.length) {
          throw buildError_(
            'GRAPHQL_ERROR',
            step,
            json.errors.map(e => e.message).join(' | '),
            { endpoint, errors: json.errors }
          );
        }

        return json.data;
      }

      if (status === 429 && attempt < CONFIG.MAX_RETRIES) {
        Utilities.sleep(CONFIG.RETRY_DELAY_MS * attempt);
        continue;
      }

      throw buildError_(
        'HTTP_ERROR',
        step,
        `HTTP ${status}: ${truncate_(body, CONFIG.MAX_ERROR_BODY_CHARS)}`,
        { endpoint, status }
      );
    } catch (err) {
      if (attempt === CONFIG.MAX_RETRIES) throw err;
      Utilities.sleep(CONFIG.RETRY_DELAY_MS * attempt);
    }
  }

  throw buildError_('RETRY_EXHAUSTED', step, 'Maximum retry attempts exceeded.', { endpoint });
}

function getJson_(endpoint, apiKey, step, context) {
  const text = getText_(endpoint, apiKey, step, context);
  return parseJson_(text, step, context);
}

function getText_(endpoint, apiKey, step, context) {
  const url = `${CONFIG.API_BASE_URL}/${endpoint}`;

  for (let attempt = 1; attempt <= CONFIG.MAX_RETRIES; attempt++) {
    try {
      const response = UrlFetchApp.fetch(url, {
        method: 'get',
        headers: {
          'x-api-key': apiKey,
          'Accept': 'application/json'
        },
        muteHttpExceptions: true
      });

      const status = response.getResponseCode();
      const body = response.getContentText();

      if (status === 200) return body;

      if (status === 429 && attempt < CONFIG.MAX_RETRIES) {
        Utilities.sleep(CONFIG.RETRY_DELAY_MS * attempt);
        continue;
      }

      throw buildError_(
        'HTTP_ERROR',
        step,
        `HTTP ${status}: ${truncate_(body, CONFIG.MAX_ERROR_BODY_CHARS)}`,
        Object.assign({}, context, { endpoint, status })
      );
    } catch (err) {
      if (attempt === CONFIG.MAX_RETRIES) throw err;
      Utilities.sleep(CONFIG.RETRY_DELAY_MS * attempt);
    }
  }

  throw buildError_('RETRY_EXHAUSTED', step, 'Maximum retry attempts exceeded.', Object.assign({}, context, { endpoint }));
}

/* =========================
 * PARSE LAYER
 * ========================= */

function processSingleGame_(seriesId, game, seriesInfo, apiKey) {
  const sequenceNumber = safeGet_(game, ['sequenceNumber'], {
    required: true,
    step: 'processSingleGame',
    context: { seriesId, game }
  });

  const summary = fetchGameSummary_(seriesId, sequenceNumber, apiKey);
  const details = fetchGameDetails_(seriesId, sequenceNumber, apiKey);

  return parseLolGameToRows_(seriesId, sequenceNumber, seriesInfo, summary, details);
}

function parseLolGameToRows_(seriesId, sequenceNumber, seriesInfo, statsFile, timelineFile) {
  const rows = [];
  const importedAt = new Date();

  const participants = safeGet_(statsFile, ['participants'], {
    required: true,
    step: 'parseLolGameToRows',
    context: { seriesId, sequenceNumber, statsKeys: Object.keys(statsFile || {}) }
  });

  const teams = safeGet_(statsFile, ['teams'], {
    required: true,
    step: 'parseLolGameToRows',
    context: { seriesId, sequenceNumber }
  });

  const frames = safeGet_(timelineFile, ['frames'], {
    defaultValue: [],
    step: 'parseLolGameToRows',
    context: { seriesId, sequenceNumber, timelineKeys: Object.keys(timelineFile || {}) }
  });

  const teamTotals = {
    100: createEmptyTeamTotals_(),
    200: createEmptyTeamTotals_()
  };

  countTeamTotals_(participants, teamTotals);
  countTurretPlates_(frames, teamTotals);
  const firstBloodVictim = detectFirstBloodVictim_(frames);
  const frameAt10 = getClosestFrameAtOrBefore10_(frames);
  const goldAt10ByParticipant = extractGoldAt10ByParticipant_(frameAt10);

  const gameDuration = toNumber_(safeGet_(statsFile, ['gameDuration'], { defaultValue: 0 }));
  const platformGameId = `${safeGet_(statsFile, ['platformId'], { defaultValue: '' })}_${safeGet_(statsFile, ['gameId'], { defaultValue: '' })}`;

  participants.forEach(player => {
    const teamId = toNumber_(safeGet_(player, ['teamId'], { defaultValue: 0 }));
    const teamTotal = teamTotals[teamId] || createEmptyTeamTotals_();
    const split = splitTeamTagAndPlayerNickname_(safeGet_(player, ['riotIdGameName'], { defaultValue: '' }));
    const participantId = toNumber_(safeGet_(player, ['participantId'], { defaultValue: 0 }));
    const role = normalizeRole_(safeGet_(player, ['teamPosition'], { defaultValue: '' }));
    const teamObj = findTeamById_(teams, teamId);
    const side = normalizeSideFromTeamId_(teamId);

    const goldAt10 = toNumber_(goldAt10ByParticipant[participantId]?.gold);
    const oppGoldAt10 = getOpponentGoldAt10ByRole_(participants, goldAt10ByParticipant, role, teamId);
    const goldDiffAt10 = goldAt10 - oppGoldAt10;

    rows.push([
      importedAt,
      String(seriesId),
      sequenceNumber,
      platformGameId,
      seriesInfo.tournament_id,
      seriesInfo.tournament_name,
      split.playerName,
      split.teamTag,
      side,
      role,
      safeGet_(player, ['championName'], { defaultValue: '' }),
      intBool_(safeGet_(player, ['win'], { defaultValue: false })),
      gameDuration,
      toNumber_(safeGet_(player, ['kills'], { defaultValue: 0 })),
      toNumber_(safeGet_(player, ['deaths'], { defaultValue: 0 })),
      toNumber_(safeGet_(player, ['assists'], { defaultValue: 0 })),
      safeDivide_(
        toNumber_(safeGet_(player, ['kills'], { defaultValue: 0 })) +
        toNumber_(safeGet_(player, ['assists'], { defaultValue: 0 })),
        Math.max(toNumber_(safeGet_(player, ['deaths'], { defaultValue: 0 })), 1)
      ),
      safeDivide_(
        toNumber_(safeGet_(player, ['kills'], { defaultValue: 0 })) +
        toNumber_(safeGet_(player, ['assists'], { defaultValue: 0 })),
        teamTotal.kills
      ),
      teamTotal.kills,
      teamTotal.deaths,
      intBool_(safeGet_(player, ['firstBloodKill'], { defaultValue: false })),
      intBool_(safeGet_(player, ['firstBloodAssist'], { defaultValue: false })),
      participantId === firstBloodVictim ? 1 : 0,
      safePerMinute_(safeGet_(player, ['totalDamageDealtToChampions'], { defaultValue: 0 }), gameDuration),
      safeDivide_(safeGet_(player, ['totalDamageDealtToChampions'], { defaultValue: 0 }), teamTotal.damageToChampions),
      safePerMinute_(safeGet_(player, ['wardsPlaced'], { defaultValue: 0 }), gameDuration),
      safePerMinute_(safeGet_(player, ['wardsKilled'], { defaultValue: 0 }), gameDuration),
      toNumber_(safeGet_(player, ['visionWardsBoughtInGame'], { defaultValue: 0 })),
      toNumber_(safeGet_(player, ['totalMinionsKilled'], { defaultValue: 0 })) +
        toNumber_(safeGet_(player, ['neutralMinionsKilled'], { defaultValue: 0 })),
      safePerMinute_(
        toNumber_(safeGet_(player, ['totalMinionsKilled'], { defaultValue: 0 })) +
        toNumber_(safeGet_(player, ['neutralMinionsKilled'], { defaultValue: 0 })),
        gameDuration
      ),
      toNumber_(safeGet_(player, ['goldEarned'], { defaultValue: 0 })),
      safePerMinute_(safeGet_(player, ['goldEarned'], { defaultValue: 0 }), gameDuration),
      intBool_(safeGet_(teamObj, ['objectives', 'tower', 'first'], { defaultValue: 0 })),
      toNumber_(safeGet_(teamObj, ['objectives', 'tower', 'kills'], { defaultValue: 0 })),
      teamTotal.turretPlates,
      intBool_(safeGet_(teamObj, ['objectives', 'dragon', 'first'], { defaultValue: 0 })),
      toNumber_(safeGet_(teamObj, ['objectives', 'dragon', 'kills'], { defaultValue: 0 })),
      intBool_(safeGet_(teamObj, ['objectives', 'riftHerald', 'first'], { defaultValue: 0 })),
      toNumber_(safeGet_(teamObj, ['objectives', 'riftHerald', 'kills'], { defaultValue: 0 })),
      toNumber_(safeGet_(teamObj, ['objectives', 'baron', 'kills'], { defaultValue: 0 })),
      toNumber_(safeGet_(teamObj, ['objectives', 'inhibitor', 'kills'], { defaultValue: 0 })),
      JSON.stringify(safeGet_(teamObj, ['bans'], { defaultValue: [] })),
      goldAt10,
      oppGoldAt10,
      goldDiffAt10
    ]);
  });

  return rows;
}

function countTeamTotals_(participants, teamTotals) {
  (participants || []).forEach(player => {
    const teamId = toNumber_(safeGet_(player, ['teamId'], { defaultValue: 0 }));
    if (!teamTotals[teamId]) teamTotals[teamId] = createEmptyTeamTotals_();

    teamTotals[teamId].kills += toNumber_(safeGet_(player, ['kills'], { defaultValue: 0 }));
    teamTotals[teamId].deaths += toNumber_(safeGet_(player, ['deaths'], { defaultValue: 0 }));
    teamTotals[teamId].damageToChampions += toNumber_(safeGet_(player, ['totalDamageDealtToChampions'], { defaultValue: 0 }));
    teamTotals[teamId].goldEarned += toNumber_(safeGet_(player, ['goldEarned'], { defaultValue: 0 }));
    teamTotals[teamId].creepScore +=
      toNumber_(safeGet_(player, ['totalMinionsKilled'], { defaultValue: 0 })) +
      toNumber_(safeGet_(player, ['neutralMinionsKilled'], { defaultValue: 0 }));
    teamTotals[teamId].wardsPlaced += toNumber_(safeGet_(player, ['wardsPlaced'], { defaultValue: 0 }));
    teamTotals[teamId].wardsKilled += toNumber_(safeGet_(player, ['wardsKilled'], { defaultValue: 0 }));
    teamTotals[teamId].controlWardsPurchased += toNumber_(safeGet_(player, ['visionWardsBoughtInGame'], { defaultValue: 0 }));
  });
}

function countTurretPlates_(frames, teamTotals) {
  (frames || []).forEach(frame => {
    if (toNumber_(frame?.timestamp) > 850000) return;
    (frame?.events || []).forEach(event => {
      if (event?.type === 'TURRET_PLATE_DESTROYED') {
        let awardedTeamId = null;
        if (event?.teamId === 200) awardedTeamId = 100;
        if (event?.teamId === 100) awardedTeamId = 200;
        if (awardedTeamId && teamTotals[awardedTeamId]) {
          teamTotals[awardedTeamId].turretPlates += 1;
        }
      }
    });
  });
}

function detectFirstBloodVictim_(frames) {
  let victimId = null;
  let found = false;

  (frames || []).some(frame => {
    if (toNumber_(frame?.timestamp) > 850000) return true;
    return (frame?.events || []).some(event => {
      if (event?.type === 'CHAMPION_KILL' && !found && toNumber_(event?.killerId) !== 0) {
        found = true;
        victimId = event?.victimId || null;
        return true;
      }
      return false;
    });
  });

  return victimId;
}

function getClosestFrameAtOrBefore10_(frames) {
  const target = 600000;
  let bestFrame = null;

  (frames || []).forEach(frame => {
    const ts = toNumber_(frame?.timestamp);
    if (ts <= target) {
      if (!bestFrame || ts > toNumber_(bestFrame.timestamp)) {
        bestFrame = frame;
      }
    }
  });

  if (!bestFrame && frames && frames.length) bestFrame = frames[0];
  return bestFrame || {};
}

function extractGoldAt10ByParticipant_(frame) {
  const out = {};
  const participantFrames = safeGet_(frame, ['participantFrames'], { defaultValue: {} });

  Object.keys(participantFrames).forEach(pid => {
    const pf = participantFrames[pid] || {};
    out[toNumber_(pid)] = {
      gold: toNumber_(pf?.totalGold)
    };
  });

  return out;
}

function getOpponentGoldAt10ByRole_(participants, goldAt10ByParticipant, role, teamId) {
  const opponent = (participants || []).find(p =>
    normalizeRole_(safeGet_(p, ['teamPosition'], { defaultValue: '' })) === String(role || '') &&
    toNumber_(safeGet_(p, ['teamId'], { defaultValue: 0 })) !== toNumber_(teamId)
  );

  if (!opponent) return 0;

  const oppParticipantId = toNumber_(safeGet_(opponent, ['participantId'], { defaultValue: 0 }));
  return toNumber_(goldAt10ByParticipant[oppParticipantId]?.gold);
}

function createEmptyTeamTotals_() {
  return {
    kills: 0,
    deaths: 0,
    damageToChampions: 0,
    goldEarned: 0,
    creepScore: 0,
    wardsPlaced: 0,
    wardsKilled: 0,
    controlWardsPurchased: 0,
