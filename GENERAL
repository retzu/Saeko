    const ss = SpreadsheetApp.getActiveSpreadsheet();

    setupImporterSheet_(getOrCreateSheet_(ss, CONFIG.IMPORTER_SHEET));
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.DB_SHEET), CONFIG.DB_HEADERS);
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.GENERAL_STATS_SHEET), CONFIG.GENERAL_STATS_HEADERS);
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.GOLD_DIFF_SHEET), CONFIG.GOLD_DIFF_HEADERS);
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.ROLE_MAP_SHEET), CONFIG.ROLE_MAP_HEADERS);
    setupSettingsSheet_(getOrCreateSheet_(ss, CONFIG.SETTINGS_SHEET));
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.SCRIM_SHEET), CONFIG.SCRIM_HEADERS);
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.LEADERBOARD_SHEET), CONFIG.LEADERBOARD_HEADERS);
    setupTableSheet_(getOrCreateSheet_(ss, CONFIG.LOG_SHEET), CONFIG.LOG_HEADERS);

    SpreadsheetApp.getUi().alert('Workspace initialized.');
  } catch (err) {
    handleError_(err);
  }
}

function importGridSeries() {
  const lock = LockService.getScriptLock();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (!lock.tryLock(5000)) {
    SpreadsheetApp.getUi().alert('Another import is already running.');
    return;
  }

  try {
    ensureBaseSheets_();

    const apiKey = getApiKey_();
    const seriesId = getSeriesIdInput_();

    ss.toast(`Importing series ${seriesId}...`, 'GRID Import', 5);

    const seriesInfo = fetchSeriesInfo_(seriesId, apiKey);
    const games = fetchSeriesGames_(seriesId, apiKey);

    if (!games.length) {
      throw buildError_('NO_GAMES', 'fetchSeriesGames', `No games found for series ${seriesId}`, { seriesId });
    }

    const allRows = [];
    games.forEach(game => {
      const rows = processSingleGame_(seriesId, game, seriesInfo, apiKey);
      allRows.push(...rows);
    });

    if (!allRows.length) {
      throw buildError_('NO_ROWS', 'importGridSeries', `No rows generated for series ${seriesId}`, { seriesId });
    }

    const inserted = saveRowsToDb_(allRows);
    refreshDerivedSheets_();

    ss.toast(`Imported ${inserted} rows.`, 'GRID Import', 5);
    SpreadsheetApp.getUi().alert(`Success.\nSeries ID: ${seriesId}\nRows inserted: ${inserted}`);
  } catch (err) {
    handleError_(err);
  } finally {
    SpreadsheetApp.flush();
    lock.releaseLock();
  }
}

function importGridSeriesBatch() {
  const lock = LockService.getScriptLock();
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (!lock.tryLock(5000)) {
    SpreadsheetApp.getUi().alert('Another import is already running.');
    return;
  }

  try {
    ensureBaseSheets_();

    const apiKey = getApiKey_();
    const importerSheet = mustGetSheet_(CONFIG.IMPORTER_SHEET);
    const lastRow = importerSheet.getLastRow();

    if (lastRow < CONFIG.BATCH_START_ROW) {
      SpreadsheetApp.getUi().alert('No batch rows found.');
      return;
    }

    const values = importerSheet.getRange(
      CONFIG.BATCH_START_ROW,
      CONFIG.BATCH_SERIES_COL,
      lastRow - CONFIG.BATCH_START_ROW + 1,
      3
    ).getValues();

    const pending = [];
    values.forEach((row, i) => {
      const seriesId = String(row[0] || '').trim();
      const status = String(row[1] || '').trim().toUpperCase();
      if (seriesId && (!status || status === 'PENDING' || status === 'ERROR')) {
        pending.push({
          rowNumber: CONFIG.BATCH_START_ROW + i,
          seriesId
        });
      }
    });

    const batch = pending.slice(0, CONFIG.BATCH_SIZE);
    if (!batch.length) {
      SpreadsheetApp.getUi().alert('No pending series IDs found.');
      return;
    }

    let totalInserted = 0;

    batch.forEach(item => {
      try {
        ss.toast(`Importing series ${item.seriesId}...`, 'GRID Batch Import', 3);

        const seriesInfo = fetchSeriesInfo_(item.seriesId, apiKey);
        const games = fetchSeriesGames_(item.seriesId, apiKey);

        if (!games.length) {
          importerSheet.getRange(item.rowNumber, CONFIG.BATCH_STATUS_COL).setValue('ERROR');
          importerSheet.getRange(item.rowNumber, CONFIG.BATCH_MESSAGE_COL).setValue('No games found');
          return;
        }

        const allRows = [];
        games.forEach(game => {
          const rows = processSingleGame_(item.seriesId, game, seriesInfo, apiKey);
          allRows.push(...rows);
        });

        const inserted = saveRowsToDb_(allRows);
        totalInserted += inserted;

        importerSheet.getRange(item.rowNumber, CONFIG.BATCH_STATUS_COL).setValue('DONE');
        importerSheet.getRange(item.rowNumber, CONFIG.BATCH_MESSAGE_COL).setValue(`Inserted ${inserted} rows`);
      } catch (err) {
        writeLogRow_(err);
        importerSheet.getRange(item.rowNumber, CONFIG.BATCH_STATUS_COL).setValue('ERROR');
        importerSheet.getRange(item.rowNumber, CONFIG.BATCH_MESSAGE_COL).setValue(truncate_(err.message, 200));
      }
    });

    refreshDerivedSheets_();
    SpreadsheetApp.getUi().alert(`Batch completed. Rows inserted: ${totalInserted}`);
  } catch (err) {
    handleError_(err);
  } finally {
    SpreadsheetApp.flush();
    lock.releaseLock();
  }
}

