function updateLeaderboard() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const scrimSheet = mustGetSheet_(CONFIG.SCRIM_SHEET);
    const settingsSheet = mustGetSheet_(CONFIG.SETTINGS_SHEET);
    const leaderboardSheet = mustGetSheet_(CONFIG.LEADERBOARD_SHEET);

    const settings = getSettingsMap_(settingsSheet);
    const pointsPerKill = toNumber_(settings['Points per Kill']);

    const placementPoints = {};
    Object.keys(settings).forEach(key => {
      const match = String(key).match(/^Placement\s+(\d+)$/i);
      if (match) placementPoints[match[1]] = toNumber_(settings[key]);
    });

    leaderboardSheet.clearContents();
    leaderboardSheet.getRange(1, 1, 1, CONFIG.LEADERBOARD_HEADERS.length)
      .setValues([CONFIG.LEADERBOARD_HEADERS]);

    const lastRow = scrimSheet.getLastRow();
    if (lastRow < 2) {
      SpreadsheetApp.getUi().alert('Leaderboard updated. No scrim data found.');
      return;
    }

    const data = scrimSheet.getRange(2, 1, lastRow - 1, CONFIG.SCRIM_HEADERS.length).getValues();
    const board = new Map();

    data.forEach(row => {
      const team = String(row[1] || '').trim();
      const placement = String(row[2] || '').trim();
      const kills = toNumber_(row[3]);
      if (!team) return;

      if (!board.has(team)) {
        board.set(team, {
          team,
          games: 0,
          wins: 0,
          top4: 0,
          totalKills: 0,
          placementPoints: 0,
          killPoints: 0,
          totalPoints: 0
        });
      }

      const rec = board.get(team);
      rec.games += 1;
      rec.totalKills += kills;
      rec.killPoints += kills * pointsPerKill;
      rec.placementPoints += toNumber_(placementPoints[placement] || 0);
      if (placement === '1') rec.wins += 1;
      if (['1', '2', '3', '4'].includes(placement)) rec.top4 += 1;
      rec.totalPoints = rec.placementPoints + rec.killPoints;
    });

    const output = Array.from(board.values())
      .sort((a, b) => b.totalPoints - a.totalPoints || b.wins - a.wins || b.totalKills - a.totalKills)
      .map(r => [r.team, r.games, r.wins, r.top4, r.totalKills, r.placementPoints, r.killPoints, r.totalPoints]);

    if (output.length) {
      leaderboardSheet.getRange(2, 1, output.length, output[0].length).setValues(output);
    }

    SpreadsheetApp.getUi().alert('Leaderboard calculated.');
  } catch (err) {
    handleError_(err);
  }
}

